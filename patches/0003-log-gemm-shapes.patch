+class _ShapeLog:
+    """Buffers one line per GEMM shape decision and appends them to a file."""
+
+    def __init__(self, path: str) -> None:
+        self.path = path
+        self.rows: list[tuple] = []
+        atexit.register(self.flush)
+
+    def add(self, m: int, n: int, k: int, noisy: bool) -> None:
+        self.rows.append((time.time(), m, n, k, noisy))
+        if len(self.rows) >= 4096:
+            self.flush()
+
+    def flush(self) -> None:
+        if not self.rows:
+            return
+        rows, self.rows = self.rows, []
+        with open(self.path, "a") as f:
+            for t, m, n, k, noisy in rows:
+                f.write(json.dumps({"time": t, "m": m, "n": n, "k": k, "noisy": noisy}) + "\n")
+
+
+# Set MINER_LOG_GEMM_SHAPES to a file path to log every shape decision.
+_shape_log = _ShapeLog(os.environ["MINER_LOG_GEMM_SHAPES"]) if os.environ.get("MINER_LOG_GEMM_SHAPES") else None
 
 
