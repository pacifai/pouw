-fn py_pad_to_chunk_boundary(data: &[u8]) -> Vec<u8> {
-    pad_to_chunk_boundary(data)
+fn py_pad_to_chunk_boundary<'py>(
+    py: Python<'py>,
+    data: &[u8],
+) -> PyResult<Bound<'py, pyo3::types::PyBytes>> {
+    // Copy straight into the new `bytes` object, with the GIL released during
+    // the copy. pyo3 zeroes the new object, so the padding needs no writes.
+    // `data` borrows an immutable `bytes` argument, and Python can't see `out`
+    // until this function returns.
+    pyo3::types::PyBytes::new_with(py, padded_chunk_len(data.len()), |out| {
+        py.allow_threads(|| out[..data.len()].copy_from_slice(data));
+        Ok(())
+    })
 }
 
